# Maintainer: Filter <linduan4506@sina.cn>
pkgname=dbrix
pkgver=0.3.2
pkgrel=1
pkgdesc="Terminal database client for PostgreSQL, MySQL, SQLite, Redis and MongoDB"
arch=('x86_64' 'aarch64')
url="https://github.com/LinduanTof/dbrix"
license=('Apache-2.0')
makedepends=('go')
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('df764f6e09dda0683f5a8bed885bb01494b2c52cc5be475a8efa9831a90b6931')

build() {
  cd "${srcdir}/dbrix-${pkgver}"
  export CGO_ENABLED=0
  go build -trimpath -ldflags "-s -w -X main.version=v${pkgver}" -o dbrix ./cmd/dbrix
}

package() {
  cd "${srcdir}/dbrix-${pkgver}"
  install -Dm755 dbrix "${pkgdir}/usr/bin/dbrix"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
